FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# The gateway does not load embedding, reranking, or document-conversion models.
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code and dependencies
COPY backend/ ./backend/
COPY localgpt_runtime.py ./localgpt_runtime.py

# Create necessary directories and initialize database
RUN mkdir -p shared_uploads logs backend

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -fsS -H "Authorization: Bearer ${LOCALGPT_API_TOKEN}" http://localhost:8000/health || exit 1

# Run the backend server
CMD ["python", "-m", "backend.server"]
