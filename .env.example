# Local inference
LLM_BACKEND=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=qwen3:8b
OLLAMA_ENRICHMENT_MODEL=qwen3:0.6b

# Service binding and browser URL
LOCALGPT_BACKEND_HOST=127.0.0.1
LOCALGPT_BACKEND_PORT=8000
LOCALGPT_RAG_HOST=127.0.0.1
RAG_CONFIG_MODE=default
# The frontend defaults to its same-origin /api/backend proxy.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# Used only by the optional command-line index helpers.
LOCALGPT_BACKEND_URL=http://127.0.0.1:8000
LOCALGPT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared storage
LOCALGPT_DB_PATH=./data/chat_data.db
LOCALGPT_UPLOAD_DIR=./shared_uploads
LOCALGPT_OVERVIEW_DIR=./index_store/overviews
LANCEDB_PATH=./lancedb
LOCALGPT_MAX_UPLOAD_BYTES=52428800

# Optional bearer authentication. If set, clients must send this token.
# LOCALGPT_API_TOKEN=replace-with-a-long-random-token

# Optional cloud generation. This sends prompts/context off-machine.
# Install first with: pip install -r requirements-watsonx.txt
# LLM_BACKEND=watsonx
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_GENERATION_MODEL=ibm/granite-13b-chat-v2
# WATSONX_ENRICHMENT_MODEL=ibm/granite-8b-japanese

# Disabled by default: allows Hugging Face repositories to execute custom code.
# LOCALGPT_TRUST_REMOTE_CODE=true
