# Docker environment configuration
# Set this to use local Ollama instance running on host
# Compose maps this hostname to the host gateway on Linux and Docker Desktop.
OLLAMA_HOST=http://host.docker.internal:11434

# Alternative: Use containerized Ollama (uncomment and run with --profile with-ollama)
# OLLAMA_HOST=http://ollama:11434

# Other configuration
NODE_ENV=production
RAG_API_URL=http://rag-api:8001
# Optional: set the same non-empty value for every service.
LOCALGPT_API_TOKEN=
