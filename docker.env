# Docker environment configuration
# Set this to use local Ollama instance running on host.
# host.docker.internal works on Docker Desktop (macOS/Windows); on Linux it is
# provided by the extra_hosts host-gateway entries in the compose files.
OLLAMA_HOST=http://host.docker.internal:11434

# Alternative: Use containerized Ollama (uncomment and run with --profile with-ollama)
# OLLAMA_HOST=http://ollama:11434

# Other configuration
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
